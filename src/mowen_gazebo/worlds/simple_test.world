<?xml version="1.0"?>
<sdf version="1.6">
  <world name="simple_test">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene><shadows>false</shadows></scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>150</iters><sor>1.4</sor>
        <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling></solver>
        <constraints><cfm>0.00001</cfm><erp>0.2</erp>
        <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
        <contact_surface_layer>0.01</contact_surface_layer></constraints>
      </ode>
    </physics>

    <!-- 椅子 (蓝色方块，Faster R-CNN 可能识别为 chair) -->
    <model name="chair1"><static>true</static><pose>2 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="coll"><geometry><box><size>0.5 0.5 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.8</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 瓶子/罐子 (绿色圆柱) -->
    <model name="bottle1"><static>true</static><pose>3 1 0.15 0 0 0</pose>
      <link name="link">
        <collision name="coll"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 第二个瓶子 -->
    <model name="bottle2"><static>true</static><pose>3.5 0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="coll"><geometry><cylinder><radius>0.08</radius><length>0.25</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.08</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.7 0.5 0.2 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 桌子 (棕色大块) -->
    <model name="table1"><static>true</static><pose>4 -1 0.4 0 0 0</pose>
      <link name="link">
        <collision name="coll"><geometry><box><size>1.2 0.8 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 0.8 0.8</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 大箱子/TV (黑色) -->
    <model name="tv1"><static>true</static><pose>5 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="coll"><geometry><box><size>0.8 0.1 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.1 0.6</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
