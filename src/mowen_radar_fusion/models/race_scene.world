<?xml version="1.0"?>
<sdf version="1.6">
  <world name="race_track">
    <include><uri>model://sun</uri></include>
    <scene><shadows>false</shadows></scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>150</iters><sor>1.4</sor>
        <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling></solver>
        <constraints><cfm>0.00001</cfm><erp>0.2</erp>
        <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
        <contact_surface_layer>0.01</contact_surface_layer></constraints>
      </ode>
    </physics>

    <!-- ====== 赛道地板 (灰色沥青) ====== -->
    <model name="track_floor"><static>true</static>
      <link name="floor">
        <collision name="coll"><geometry><box><size>12 8 0.05</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>12 8 0.05</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <pose>0 0 0.025 0 0 0</pose>
    </model>

    <!-- ====== 外围围墙 12x8m ====== -->
    <model name="wall_n"><static>true</static><pose>0 4 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>12 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.5 0.2 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s"><static>true</static><pose>0 -4 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>12 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.5 0.2 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e"><static>true</static><pose>6 0 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.1 8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8 1.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.5 0.2 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w"><static>true</static><pose>-6 0 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.1 8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8 1.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.5 0.2 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ====== 赛道边界线 (白色) ====== -->
    <model name="track_lane_L"><static>true</static><pose>0 1.5 0.055 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>11 0.15 0.01</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual></link>
    </model>
    <model name="track_lane_R"><static>true</static><pose>0 -0.5 0.055 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>11 0.15 0.01</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual></link>
    </model>
    <!-- 横向连接 (U型底部) -->
    <model name="track_lane_bottom"><static>true</static><pose>5 0.5 0.055 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.15 2 0.01</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual></link>
    </model>

    <!-- ====== 起点线 (红色) ====== -->
    <model name="start_line"><static>true</static><pose>-5 0.5 0.056 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.2 2.2 0.01</size></box></geometry>
        <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse></material>
      </visual></link>
    </model>

    <!-- ====== 赛道中央障碍物 ====== -->
    <include><uri>model://cardboard_box</uri><pose>2 0.5 0 0 0 0</pose></include>
    <include><uri>model://cardboard_box</uri><pose>2.5 0.5 0 0 0 0</pose></include>
    <include><uri>model://jersey_barrier</uri><pose>-1 0.5 0 0 0 0</pose></include>
    <include><uri>model://jersey_barrier</uri><pose>-0.5 0.5 0 0 0 0</pose></include>
    <include><uri>model://construction_cone</uri><pose>4 1.2 0 0 0 0</pose></include>
    <include><uri>model://construction_cone</uri><pose>4 -0.2 0 0 0 0</pose></include>

    <!-- ====== 角落静态物体 ====== -->
    <include><uri>model://hatchback_red</uri><pose>5 2.5 0 0 0 0</pose></include>
    <include><uri>model://person_standing</uri><pose>3 3 0 0 0 1.57</pose></include>
    <include><uri>model://person_standing</uri><pose>-3 3 0 0 0 -0.5</pose></include>
    <include><uri>model://dumpster</uri><pose>-4.5 -2.5 0 0 0 0</pose></include>
    <include><uri>model://cafe_table</uri><pose>-3 -3 0 0 0 0</pose></include>
    <include><uri>model://hatchback</uri><pose>4 -3 0 0 0 0</pose></include>

    <!-- ====== 场景装饰 ====== -->
    <include><uri>model://stop_sign</uri><pose>-5.5 0.5 0 0 0 0</pose></include>
    <include><uri>model://number1</uri><pose>-5.5 3 0 0 0 0</pose></include>
    <include><uri>model://number2</uri><pose>-2.5 3 0 0 0 0</pose></include>
    <include><uri>model://number3</uri><pose>0.5 3 0 0 0 0</pose></include>
    <include><uri>model://lamp_post</uri><pose>5.5 3.5 0 0 0 0</pose></include>
    <include><uri>model://lamp_post</uri><pose>-5.5 -3.5 0 0 0 0</pose></include>
    <include><uri>model://fire_hydrant</uri><pose>-5 2 0 0 0 0</pose></include>

  </world>
</sdf>
